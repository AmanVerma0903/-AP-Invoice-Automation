# Zamp AP Invoice Automation Configuration

# Primary AI Extraction Engine: Google Gemini API
# Leave blank to run 100% offline using the robust deterministic local fallback pipeline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Tolerance Policy Configuration
MAX_TOLERANCE_USD=50.00
MAX_TOLERANCE_PERCENTAGE=0.02

# SQLite Database File Path (defaults to zamp_ap.db in workspace root)
DATABASE_PATH=zamp_ap.db
